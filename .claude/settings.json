{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/seo-runtime.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/skills/seo/hooks/run-python-hook.js\" \"$CLAUDE_PROJECT_DIR/.claude/skills/seo/hooks/validate-schema.py\""
          }
        ]
      }
    ]
  }
}
